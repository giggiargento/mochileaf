---
import type { Update } from '../../types';
import { loadArticles } from '../../data/articles';
import { getGame } from '../../data/games';
import { getArticleHref } from '../../utils/article-routes';
import { getGameDisplayName } from '../../utils/game-display';
import { localePath, resolveLocale } from '../../i18n/locale';
import { t } from '../../i18n/messages';
import Icon from '../ui/Icon.astro';

interface Props {
  update: Update;
}

const { update } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const game = update.gameSlug ? getGame(update.gameSlug, locale) : undefined;
const articles = await loadArticles(locale);

let href = update.gameSlug
  ? localePath(`/${update.gameSlug}/news`, locale)
  : localePath('/articles', locale);

const linkedArticle =
  update.articleSlug && update.gameSlug
    ? articles.find((a) => a.slug === update.articleSlug && a.gameSlug === update.gameSlug)
    : undefined;

if (linkedArticle) href = getArticleHref(linkedArticle, locale);

const gameHref = game ? localePath(`/${game.slug}`, locale) : undefined;
const displayTitle = linkedArticle?.title ?? update.title;

const typeIcons: Record<Update['type'], string> = {
  patch: 'cloud',
  event: 'calendar-star',
  content: 'book-open',
  community: 'users-three',
};

const dateLocale = 'en-US';
---

<li class="flex gap-4 py-4">
  <div
    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-nav text-accent"
    aria-hidden="true"
  >
    <Icon name={typeIcons[update.type]} size={20} weight="regular" />
  </div>
  <div class="min-w-0 flex-1">
    <p class="text-xs font-medium uppercase tracking-wide text-accent">
      {t(`update.type.${update.type}`, locale)}
    </p>
    <h3 class="mt-0.5 font-medium leading-snug">
      <a
        href={href}
        class="cozy-link no-underline hover:underline"
        {...(update.articleSlug ? { 'data-astro-reload': true } : {})}
      >
        {displayTitle}
      </a>
    </h3>
    <p class="mt-1 text-sm text-muted">
      {
        game ? (
          <>
            <a href={gameHref} class="cozy-link no-underline hover:underline">
              {getGameDisplayName(game, 'short')}
            </a>
            {' · '}
          </>
        ) : null
      }
      <time datetime={update.date}>
        {new Date(update.date).toLocaleDateString(dateLocale, { month: 'short', day: 'numeric' })}
      </time>
    </p>
  </div>
</li>
