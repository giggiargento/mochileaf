---
import type { NavItem } from '../../types';
import {
  findBestNavMatch,
  isNavItemActive,
  normalizeNavPath,
} from '../../utils/navigation';
import { stripLocalePrefix } from '../../i18n/routing';

interface Props {
  items: NavItem[];
  /** Accessible name, e.g. game short name */
  label: string;
  /** View-transition persist id — must differ per game hub + locale */
  persistKey: string;
}

const { items, label, persistKey } = Astro.props;
const currentPath = stripLocalePrefix(normalizeNavPath(Astro.url.pathname));
const bestMatch = findBestNavMatch(items, currentPath);
---

<nav
  transition:persist={persistKey}
  transition:animate="none"
  class="game-hub-mobile-tabs"
  data-game-hub-tabs
  aria-label={`${label} sections`}
>
  {
    items.map((item) => {
      const active = isNavItemActive(item, bestMatch);
      return (
        <a
          href={item.href}
          class:list={['game-hub-mobile-tab', active && 'is-active']}
          aria-current={active ? 'page' : undefined}
        >
          {item.label}
        </a>
      );
    })
  }
</nav>
