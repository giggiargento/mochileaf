---
import CozyImage from '../ui/CozyImage.astro';
import { gameLogoImagePath } from '../../utils/game-images';
import type { Game } from '../../types';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const logoSrc = gameLogoImagePath(game.slug);
const logoAlt = `${game.name} logo`;
---

<header class="animate-fade-in">
  <div class="page-container pb-10 pt-10 text-left md:pb-14 md:pt-14">
    {
      logoSrc && (
        <CozyImage
          src={logoSrc}
          alt={logoAlt}
          width={92}
          height={92}
          class="game-hub-logo"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <slot />
  </div>
</header>
