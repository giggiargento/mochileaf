---
import CozyImage from '../ui/CozyImage.astro';
import { gameLogoImagePath } from '../../utils/game-images';
import { getGameHubLogo } from '../../lib/game-card-display';
import type { Game } from '../../types';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const hubLogo = getGameHubLogo(game.slug);
const logoSrc = hubLogo?.src ?? gameLogoImagePath(game.slug);
const logoAlt = `${game.name} logo`;
const logoStyle = hubLogo
  ? `object-fit: ${hubLogo.objectFit ?? 'cover'}; object-position: ${hubLogo.objectPosition ?? 'center'};`
  : undefined;
---

<header class="animate-fade-in">
  <div class="page-container pb-10 pt-10 text-left md:pb-14 md:pt-14">
    {
      logoSrc && (
        <CozyImage
          src={logoSrc}
          alt={logoAlt}
          width={92}
          height={92}
          class="game-hub-logo"
          style={logoStyle}
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <slot />
  </div>
</header>
