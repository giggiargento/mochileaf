---
import GameHubLayout from '../../../layouts/GameHubLayout.astro';
import PageHeader from '../../../components/game/PageHeader.astro';
import ContentGrid from '../../../components/game/ContentGrid.astro';
import WallpaperCard from '../../../components/game/WallpaperCard.astro';
import WallpapersDonateBanner from '../../../components/game/WallpapersDonateBanner.astro';
import { games } from '../../../data/games';
import { getWallpapersByGame, getWallpaperPageCopyKeys } from '../../../data/wallpapers';
import { usePageLocale } from '../../../lib/i18n/use-page-locale';
import { t } from '../../../i18n/messages';

export function getStaticPaths() {
  return games
    .filter((g) => g.status === 'active' && getWallpapersByGame(g.slug).length > 0)
    .map((game) => ({ params: { game: game.slug }, props: { game } }));
}

const { game } = Astro.props;
const { locale, tr } = usePageLocale(Astro.currentLocale);
const wallpapers = getWallpapersByGame(game.slug, locale);
const wallpaperCopy = getWallpaperPageCopyKeys(game.slug);
const hubLabel = game.shortName ?? game.name;
---

<GameHubLayout
  game={game}
  title={t('nav.wallpapers', locale)}
  description={tr(wallpaperCopy.meta, { game: game.name })}
>
  <PageHeader
    title={tr('wallpapers.title')}
    description={tr(wallpaperCopy.description, { hub: hubLabel })}
  />
  <div class="page-container-below-header space-y-12">
    <ContentGrid columns={3}>
      {wallpapers.map((wallpaper) => (
        <WallpaperCard wallpaper={wallpaper} />
      ))}
    </ContentGrid>

    <WallpapersDonateBanner />

    <p class="max-w-2xl text-sm text-muted">{tr(wallpaperCopy.footer)}</p>
  </div>
</GameHubLayout>
